{
  "name": "seee-workspace",
  "version": "3.0.0",
  "private": true,
  "description": "School-wide SEEE workspace with scoped roles and configurable approvals",
  "main": "app.js",
  "scripts": {
    "dev": "node --watch app.js",
    "start": "node app.js",
    "setup:local": "node scripts/local/setup.js",
    "reset:local": "node scripts/local/reset.js",
    "db:start": "node scripts/local/database.js",
    "db:stop": "node scripts/local/stop.js",
    "test": "node --test --test-concurrency=1 tests/workspace/*.test.js",
    "test:ui": "node tests/workspace/browser.js",
    "check": "node scripts/check.js"
  },
  "engines": {
    "node": ">=22 <23"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "dotenv": "^16.6.1",
    "exceljs": "^4.4.0",
    "express": "^5.1.0",
    "express-session": "^1.18.2",
    "helmet": "^8.1.0",
    "multer": "^2.3.0",
    "mysql2": "^3.23.2",
    "nodemailer": "^9.0.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0"
  },
  "overrides": {
    "exceljs": {
      "uuid": "11.1.1"
    }
  }
}
