# Gmail notifications (use a Google App Password, not your normal password)
GMAIL_USER=dtnhsv.seeehust@gmail.com
GMAIL_APP_PASSWORD=your-google-app-password
MAIL_FROM_NAME=SEEE Activity Hub
APP_BASE_URL=https://sv-seee.site
EMAIL_NOTIFICATIONS_ENABLED=true

# Microsoft Entra ID SSO for HUST accounts
# Register AZURE_REDIRECT_URI as a Web redirect URI in the Entra app registration.
AZURE_TENANT=hust.edu.vn
AZURE_CLIENT_ID=your-application-client-id
AZURE_CLIENT_SECRET=your-application-client-secret
AZURE_REDIRECT_URI=https://sv-seee.site/auth/microsoft/callback
# Both @hust.edu.vn and @sis.hust.edu.vn are accepted by the application.
AZURE_ALLOWED_DOMAIN=hust.edu.vn

# Database backups (keep this outside public/ and preferably outside the app directory)
DB_BACKUP_DIR=/home/your-cpanel-user/backups/dtn
DB_BACKUP_RETENTION_DAYS=14
MYSQLDUMP_PATH=/usr/bin/mysqldump

# OneSignal web push notifications
ONESIGNAL_APP_ID=your-onesignal-app-id
ONESIGNAL_API_KEY=your-onesignal-app-api-key
