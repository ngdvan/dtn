# SEEE Workspace 3.0 — local-development settings
# npm run setup:local writes .env.local with randomly generated DB/session secrets.
# Manual configuration: copy this file to .env.local and fill the values below.
WORKSPACE_DB_HOST=127.0.0.1
WORKSPACE_DB_PORT=3307
WORKSPACE_DB_USER=seee_local
WORKSPACE_DB_PASSWORD=replace-with-your-local-database-password
WORKSPACE_DB_NAME=seee_workspace_local
WORKSPACE_SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters
WORKSPACE_PORT=3000
# Synthetic seeded password login is for loopback local development only.
LOCAL_DEMO_AUTH=true

# Real HUST identity requires a registered Microsoft application.
# Do not use demo identities to verify real staff identity or authority.
# Set LOCAL_DEMO_AUTH=false for real identity testing.
AZURE_TENANT=hust.edu.vn
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_REDIRECT_URI=http://localhost:3000/auth/microsoft/callback
